export function OUR(a, b){
  return {
    identity: "∎ω",
    value: [a, b],
    visible: true,
    unchanged: true,
    combined: true
  };
}
-------------------------
export function SHOW_UNIJ(figur){
  return {
    identity: "∎ω",
    figur: figur,
    layer: figur.layer || null,
    symbol: figur.symbol || "∎",
    cause: figur.cause || null,
    effect: figur.effect || null,
    echo: {
      form: figur.form,
      axis: figur.axis,
      orbit: figur.orbit,
      pulse: figur.pulse
    },
    unchanged: true,
    visible: true
  };
}
---------------------------------
